+/***********************************************************************
+ *           SetTimerQueueTimer    (KERNEL32.@)
+ */
+HANDLE WINAPI SetTimerQueueTimer( HANDLE queue, WAITORTIMERCALLBACK callback, void *arg,
+                                 DWORD when, DWORD period, BOOL prefer_io )
+{
+    HANDLE timer;
+
+    if (!CreateTimerQueueTimer( &timer, queue, callback, arg, when, period,
+                               prefer_io ? WT_EXECUTEINIOTHREAD : WT_EXECUTEDEFAULT ))
+        return NULL;
+    return timer;
+}
